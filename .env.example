GPUFLOW_MYSQL_PASSWORD=replace-with-a-long-random-password
GPUFLOW_MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
# 中国大陆等无法直连 Docker Hub 的环境可替换为镜像代理地址。
GPUFLOW_MYSQL_IMAGE=mysql:8.4.11@sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb
GPUFLOW_MYSQL_BIND=127.0.0.1
GPUFLOW_MYSQL_PORT=3306
GPUFLOW_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
