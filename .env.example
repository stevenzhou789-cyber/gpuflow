GPUFLOW_TOKEN=replace-with-a-long-random-token
# 本地源码构建使用 gpuflow:local；正式部署和升级应设置为明确的 v*、sha-* 镜像或 Digest。
GPUFLOW_IMAGE=gpuflow:local
GPUFLOW_AGENT_IMAGE=gpuflow:local
# 控制面自动下发固定的 glibc Probe 镜像，计算节点无需重复配置。
GPUFLOW_PROBE_IMAGE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
GPUFLOW_PUBLIC_URL=http://127.0.0.1:18080
GPUFLOW_MYSQL_PASSWORD=replace-with-a-long-random-password
GPUFLOW_MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
# 中国大陆等无法直连 Docker Hub 的环境可替换为镜像代理地址。
GPUFLOW_MYSQL_IMAGE=mysql:8.4
GPUFLOW_MYSQL_BIND=127.0.0.1
GPUFLOW_MYSQL_PORT=3306
GPUFLOW_MINIO_IMAGE=minio/minio:latest
GPUFLOW_MINIO_ROOT_USER=gpuflow
GPUFLOW_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
GPUFLOW_MINIO_BIND=127.0.0.1
GPUFLOW_MINIO_PORT=9000
GPUFLOW_MINIO_CONSOLE_PORT=9001
GPUFLOW_S3_BUCKET=gpuflow-artifacts
