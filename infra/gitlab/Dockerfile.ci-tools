# CI tooling only. This image is not an application/runtime delivery image.
# All source stages are pinned; no signing credentials enter this build.
FROM golang:1.25-bookworm@sha256:3b4a11519ad929d1e1d261a12cff056f0c85b735253d7d861346b9c6f8b36437 AS golang
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS node
FROM docker:29.3.1-cli@sha256:18f5ab0fab739ea822819b342357947dfba235cdef438cce345ebc0c143c5b34 AS docker
FROM ghcr.io/sigstore/cosign/cosign:v3.1.3@sha256:9e5c2f2edc34351160407ca3416c61855bdf9403c3c5936e0f0be7fc261611b8 AS cosign
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim@sha256:5ef85cc12cb25be6ec319a7392d1e9efd53c3bc8abb971c53d8058a473f09053

COPY --from=golang /usr/local/go /usr/local/go
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=docker /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
ENV PATH="/usr/local/go/bin:/usr/local/bin:${PATH}" \
    GOMAXPROCS=2 GOFLAGS=-p=2 GOMEMLIMIT=768MiB \
    NODE_OPTIONS=--max-old-space-size=768 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 POWERSHELL_TELEMETRY_OPTOUT=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    PLAYWRIGHT_MODULE=/opt/playwright/node_modules/playwright/index.mjs \
    SIGSTORE_TRUSTED_ROOT_FILE=/opt/sigstore/trusted_root.json
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git jq python3 openssl unzip zip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Validate Trivy's immutable release checksum AND its Sigstore identity before
# executing it. Do not use the compromised March 2026 versions or mutable action
# tags. This signature/identity check fails closed on network/trust errors.
RUN mkdir -p /opt/sigstore /tmp/trivy-download \
    && cosign initialize \
    && find /root/.sigstore -name trusted_root.json -exec cp '{}' /opt/sigstore/trusted_root.json ';' \
    && test -s /opt/sigstore/trusted_root.json \
    && cd /tmp/trivy-download \
    && curl --fail --location --retry 3 -O https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-64bit.tar.gz \
    && curl --fail --location --retry 3 -O https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-64bit.tar.gz.sigstore.json \
    && echo '2ae6fe3ee734b7fdf11335663e18c75ea12dccc76062f09f164a3b0f8be4371a  trivy_0.74.0_Linux-64bit.tar.gz' | sha256sum -c - \
    && cosign verify-blob --offline --trusted-root /opt/sigstore/trusted_root.json \
      --certificate-identity-regexp '^https://github\.com/aquasecurity/trivy/' \
      --certificate-oidc-issuer https://token.actions.githubusercontent.com \
      --bundle trivy_0.74.0_Linux-64bit.tar.gz.sigstore.json trivy_0.74.0_Linux-64bit.tar.gz \
    && tar -xzf trivy_0.74.0_Linux-64bit.tar.gz -C /usr/local/bin trivy \
    && rm -rf /tmp/trivy-download
RUN npm install --prefix /opt/playwright --save-exact --no-audit --no-fund playwright@1.63.0 \
    && /opt/playwright/node_modules/.bin/playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && go version && node --version && pwsh --version \
    && docker --version && docker buildx version && docker compose version \
    && cosign version && trivy --version
ENTRYPOINT []
CMD ["bash"]
