# Keep local credentials, data and temporary worktrees out of the build context.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!pkg/
!pkg/**
!web/
!web/**
!scripts/check-community-boundary.mjs
web/node_modules/
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts
**/.env
**/.env.*
**/*.key
**/*.pem
**/.git
**/node_modules
**/*.exe
**/*.credential.xml
**/license.json
**/license-*.json
**/backups
**/acceptance-backup
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.7z
**/*.rar
**/*.db
**/*.sqlite
**/*.sqlite3
**/.go-cache-*
**/.build-cache
**/.cache
**/.tmp
**/.tmp-*
**/.local-gitlab
**/.gitlab-migration-work
**/.issuer
